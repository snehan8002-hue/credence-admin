rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function primary() { return signedIn() && request.auth.uid == 'aBYdbFwbsTUbpmYtoNurxyu3Roj2'; }
    function admin() { return primary() || (signedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.active == true); }
    function teacher() { return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true; }
    function student() { return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true; }
    function learnerOrTeacher() { return student() || teacher(); }
    function studentOwner(data) { return signedIn() && data.active == true && ((request.auth.token.email != null && data.email == request.auth.token.email) || (request.auth.token.phone_number != null && data.phone == request.auth.token.phone)); }
    function validStudent(data) { return data.keys().hasAll(['name','rollNo','className','phone','email','active','createdAt','updatedAt']) && data.keys().hasOnly(['name','rollNo','className','phone','email','active','createdAt','updatedAt']) && data.name is string && data.rollNo is string && data.className is string && data.phone is string && data.email is string && data.active is bool && data.createdAt is timestamp && data.updatedAt is timestamp; }
    function chatMember(data) { return signedIn() && data.participants is list && data.participants.size() == 2 && data.participants.hasAny([request.auth.uid]); }
    function validRegistration(data) { return data.keys().hasAll(['name','email','phone','role','status','createdAt']) && data.keys().hasOnly(['name','email','phone','role','status','createdAt']) && data.name is string && data.email is string && data.phone is string && data.role in ['student','teacher'] && data.status == 'pending' && data.createdAt is timestamp; }
    function validPayment(data) { return data.keys().hasAll(['studentUid','amount','utr','status','createdAt']) && data.keys().hasOnly(['studentUid','studentEmail','amount','utr','status','createdAt']) && data.studentUid is string && data.amount is number && data.amount > 0 && data.utr is string && data.utr.size() > 2 && data.status == 'pending' && data.createdAt is timestamp && (!data.keys().hasAny(['studentEmail']) || data.studentEmail is string); }
    match /registrationRequests/{id} { allow create: if validRegistration(request.resource.data) && request.resource.data.createdAt == request.time; allow get, list: if admin(); allow update, delete: if admin(); }
    match /superAdmins/{id} { allow get, list: if admin() || student() || teacher(); allow create: if admin() && request.resource.data.uid == id && request.resource.data.createdAt == request.time; allow update: if admin() && request.resource.data.uid == resource.data.uid; allow delete: if primary() && id != 'aBYdbFwbsTUbpmYtoNurxyu3Roj2'; }
    match /students/{id} { allow get: if admin() || teacher() || (id == request.auth.uid && studentOwner(resource.data)); allow list: if admin() || teacher(); allow create: if admin() && validStudent(request.resource.data) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time; allow update: if admin() && validStudent(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time; allow delete: if admin(); }
    match /teachers/{id} { allow get, list: if admin() || teacher() || student(); allow create, update, delete: if admin(); }
    match /classes/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /tests/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /questions/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /results/{id} { allow read: if admin() || teacher() || (student() && resource.data.studentUid == request.auth.uid); allow create: if teacher() || admin() || (student() && request.resource.data.studentUid == request.auth.uid); allow update, delete: if teacher() || admin(); }
    match /fees/{id} { allow get: if admin() || teacher() || (student() && resource.data.studentUid == request.auth.uid); allow list: if admin() || teacher(); allow create, update, delete: if admin(); }
    match /payments/{id} { allow get, list: if admin(); allow create: if student() && request.resource.data.studentUid == request.auth.uid && validPayment(request.resource.data) && request.resource.data.createdAt == request.time; allow update, delete: if admin(); }
    match /videos/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /notifications/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /notes/{id} { allow read: if learnerOrTeacher() || admin(); allow create, update, delete: if teacher() || admin(); }
    match /system/{id} { allow read: if signedIn(); allow create, update, delete: if admin(); }
    match /chats/{chatId} { allow create: if chatMember(request.resource.data); allow get, update, delete: if chatMember(resource.data); match /messages/{messageId} { allow read: if chatMember(get(/databases/$(database)/documents/chats/$(chatId)).data); allow create: if chatMember(get(/databases/$(database)/documents/chats/$(chatId)).data) && request.resource.data.senderUid == request.auth.uid && request.resource.data.text is string; allow update, delete: if chatMember(get(/databases/$(database)/documents/chats/$(chatId)).data) && resource.data.senderUid == request.auth.uid; } }
    match /userChats/{uid}/items/{chatId} { allow read, list: if signedIn() && request.auth.uid == uid; allow create, update: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.resource.data.participants.hasAny([request.auth.uid]) && request.resource.data.participants.hasAny([uid]); allow delete: if signedIn() && request.auth.uid == uid; }
    match /{document=**} { allow read, write: if false; }
  }
}
