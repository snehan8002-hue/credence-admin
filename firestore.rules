rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPrimaryAdmin() { return signedIn() && request.auth.uid == 'aBYdbFwbsTUbpmYtoNurxyu3Roj2'; }
    function isSuperAdmin() {
      return isPrimaryAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
          && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.active == true);
    }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }
    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true;
    }
    function isLearnerOrTeacher() { return isStudent() || isTeacher(); }
    function isStudentOwner(data) {
      return signedIn() && data.active == true && (
        (request.auth.token.email != null && data.email == request.auth.token.email)
        || (request.auth.token.phone_number != null && data.phone == request.auth.token.phone_number)
      );
    }
    function hasStudentFields(data) {
      return data.keys().hasAll(['name','rollNo','className','phone','email','active','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','rollNo','className','phone','email','active','createdAt','updatedAt'])
        && data.name is string && data.rollNo is string && data.className is string
        && data.phone is string && data.email is string && data.active is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /superAdmins/{adminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['uid','name','email','active','createdAt','createdBy'])
        && request.resource.data.uid == adminId
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.active is bool && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get: if isSuperAdmin() || (studentId == request.auth.uid && isStudentOwner(resource.data));
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && hasStudentFields(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isSuperAdmin() && hasStudentFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /teachers/{teacherId} {
      allow get: if isSuperAdmin() || (teacherId == request.auth.uid && isTeacher());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /classes/{classId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /tests/{testId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /questions/{questionId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /results/{resultId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /fees/{feeId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    match /videos/{videoId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /notes/{noteId} {
      allow read: if isLearnerOrTeacher() || isSuperAdmin();
      allow create, update, delete: if isTeacher() || isSuperAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
