rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function primary() { return signedIn() && request.auth.uid == 'aBYdbFwbsTUbpmYtoNurxyu3Roj2'; }
    function activeTeacher() {
      return signedIn() && firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.active == true;
    }
    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /banners/{uid}/{fileName=**} {
      allow read: if signedIn();
      allow write: if primary() && validImage();
    }

    match /notes/{uid}/{fileName=**} {
      allow read: if signedIn();
      allow write: if (primary() || activeTeacher()) && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
